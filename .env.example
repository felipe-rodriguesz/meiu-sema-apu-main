# Gere dois valores diferentes com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use hexadecimal para POSTGRES_PASSWORD, pois ele também compõe a URL do banco.
POSTGRES_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
# Para HTTPS, configure um domínio com DNS apontando ao servidor.
PUBLIC_DOMAIN=
